# Local dev settings (loaded by app/backend/config.py)

DATABASE_PATH=./data

# --- Embedding model (RAG ingest + retrieval) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Chat model (reply generation) ---
# LLM_PROVIDER: template | local-gateway | openai_compat | gemini
#   template        — emotion templates only (no model call)
#   local-gateway   — dev.local-ai :8080 (LLM_URL + LLM_MODEL)
#   openai_compat   — OpenAI-compatible API
#   gemini          — Google Gemini
LLM_PROVIDER=local-gateway

# openai_compat
# LLM gateway (dev.local-ai :8080)
LLM_URL=http://100.90.225.26:8080/v1
LLM_MODEL=gemma4
# LLM_API_KEY=                 # optional Bearer token
#LLM_MODEL=mlx
LLM_MODEL=nemotron
#LLM_MODEL=glm

LLM_FALLBACK_MODELS=mlx
LLM_FALLBACK_ENABLED=1